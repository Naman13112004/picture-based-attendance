DATABASE_URL=your_postgresql_db_url_neon

JWT_SECRET=your_jwt_secret_min_32_char

GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

PORT=5000

PYTHON_API_BASE_URL="http://ai-service:8000"

SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_BUCKET="snapattend-uploads"

CORS_ORIGIN=http://localhost:3000

# Redis (Upstash) — BullMQ queue
REDIS_URL=your_upstash_redis_url

# Supabase bucket for classroom photos (separate from student face photos)
CLASSROOM_PHOTOS_BUCKET="classroom-photos"

# Worker settings (optional — defaults shown)
WORKER_CONCURRENCY=1
AI_RECOGNIZE_TIMEOUT_MS=90000

# cosine distance; tune between 0.3–0.6
PGVECTOR_SIMILARITY_THRESHOLD=0.5

# bull board credentials
BULL_BOARD_USERNAME=your_bull_board_username
BULL_BOARD_PASSWORD=your_bull_board_password