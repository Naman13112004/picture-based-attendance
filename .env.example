# ==========================================
# Frontend (Next.js) Environment Variables
# Location: frontend/.env
# ==========================================
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"
NEXT_PUBLIC_BACKEND_API_URL="https://your-production-backend.com/api"
NEXT_PUBLIC_LOCAL_API_URL="http://localhost:5000/api"

# ==========================================
# Backend (Node.js/Express) Environment Variables
# Location: backend/.env
# ==========================================
# Database Connection
# If using Docker Compose, use this:
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/snapattend"
# If running locally without docker DB:
# DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# PostgreSQL initial setup (Used by docker-compose)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="snapattend"

# Authentication Secrets
JWT_SECRET="generate_a_secure_random_string_here"

# Google OAuth Credentials
GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret"

# Server Configuration
PORT=5000

# Connection to AI Service
# If using Docker Compose:
PYTHON_API_BASE_URL="http://ai-service:8000"
# If running locally:
# PYTHON_API_BASE_URL="http://127.0.0.1:8000"

# Supabase Configuration (Storage only — Auth is NOT used)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"
# Bucket for student face photos
SUPABASE_BUCKET="snapattend-uploads"
# Bucket for classroom photos submitted by teachers
CLASSROOM_PHOTOS_BUCKET="classroom-photos"

# ==========================================
# Redis (Upstash) — BullMQ async queue
# ==========================================
# Get this from your Upstash console: Redis → Connect → ioredis
# Format: rediss://default:<PASSWORD>@<HOST>:<PORT>
REDIS_URL="rediss://default:your_upstash_token@your-upstash-host.upstash.io:6379"

# Worker configuration (optional)
WORKER_CONCURRENCY=1
AI_RECOGNIZE_TIMEOUT_MS=90000
AI_REGISTER_TIMEOUT_MS=30000

# cosine distance; tune between 0.3–0.6
PGVECTOR_SIMILARITY_THRESHOLD=0.5

CORS_ORIGIN="http://localhost:3000/"

BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=password123